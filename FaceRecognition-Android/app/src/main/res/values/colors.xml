<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════
         Brand Palette — TapInX Design System 2.0
         Primary: Electric Violet  #7C3AFF
         Accent:  Neon Cyan        #06D6FF
         ═══════════════════════════════════════════════ -->

    <!-- Core Brand -->
    <color name="primary_brand">#7C3AFF</color>
    <color name="primary_brand_dark">#5B1EE8</color>
    <color name="primary_brand_light">#9B6AFF</color>
    <color name="accent_cyan">#06D6FF</color>
    <color name="accent_cyan_light">#40E4FF</color>
    <color name="accent_pink">#FF2D87</color>

    <!-- Status -->
    <color name="status_success">#00E87A</color>
    <color name="status_success_dark">#00B860</color>
    <color name="status_error">#FF3B3B</color>
    <color name="status_warning">#FFB020</color>

    <!-- Deep Space Surfaces (ARGB format for Android) -->
    <!-- #07071A = bg base -->
    <color name="bg_main">#07071A</color>
    <!-- #0D0C2A = surface cards -->
    <color name="bg_surface">#0D0C2A</color>
    <!-- #131230 = elevated card -->
    <color name="bg_elevated">#131230</color>
    <!-- #1A1940 = selected/hover -->
    <color name="bg_overlay">#1A1940</color>
    <!-- Input: 6% white over bg -->
    <color name="bg_input">#0F0F0F</color>

    <!-- Text -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#C4C4E0</color>
    <color name="text_tertiary">#8080B0</color>
    <color name="text_muted">#8080B0</color>
    <color name="text_dim">#505080</color>

    <!-- Borders (ARGB) -->
    <!-- rgba(124,58,255,0.18) = #2E7C3AFF -->
    <color name="border_color">#2E7C3AFF</color>
    <!-- rgba(124,58,255,0.35) = #597C3AFF -->
    <color name="border_active">#597C3AFF</color>
    <!-- rgba(6,214,255,0.25) = #4006D6FF -->
    <color name="border_accent">#4006D6FF</color>

    <!-- Glass / Transparency -->
    <!-- rgba(255,255,255,0.06) = #0FFFFFFF -->
    <color name="glass_bg">#0FFFFFFF</color>
    <!-- rgba(124,58,255,0.15) = #267C3AFF -->
    <color name="glass_stroke">#267C3AFF</color>
    <color name="glass_shadow">#66000000</color>

    <!-- Gradient ramp -->
    <color name="gradient_start">#07071A</color>
    <color name="gradient_mid">#100F38</color>
    <color name="gradient_end">#0D0C2A</color>
    <color name="gradient_brand_start">#7C3AFF</color>
    <color name="gradient_brand_end">#06D6FF</color>

    <!-- Attendance status -->
    <color name="present_green">@color/status_success</color>
    <color name="absent_red">@color/status_error</color>
    <color name="late_amber">@color/status_warning</color>

    <!-- ─── Legacy aliases (names used by layouts/code) ─────── -->
    <color name="vision_navy_900">@color/bg_main</color>
    <color name="vision_navy_800">@color/bg_surface</color>
    <color name="vision_navy_700">@color/bg_elevated</color>
    <color name="vision_blue">@color/primary_brand</color>
    <color name="vision_cyan">@color/accent_cyan</color>
    <color name="vision_violet">@color/primary_brand</color>
    <color name="vision_success">@color/status_success</color>
    <color name="vision_warning">@color/status_warning</color>
    <color name="vision_error">@color/status_error</color>
    <color name="vision_red">@color/status_error</color>
    <color name="vision_text_primary">@color/text_primary</color>
    <color name="vision_text_secondary">@color/text_secondary</color>
    <color name="vision_text_tertiary">@color/text_muted</color>
    <color name="glass_surface_light">@color/bg_surface</color>
    <color name="glass_stroke_light">@color/border_color</color>
    <color name="primary_blue">@color/primary_brand</color>
    <color name="primary_dark_blue">@color/bg_main</color>
    <color name="background_dark">@color/bg_main</color>
    <color name="background_card_dark">@color/bg_surface</color>
    <color name="background_input_dark">@color/glass_bg</color>
    <color name="success_green">@color/status_success</color>
    <color name="error_red">@color/status_error</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="electric_blue">@color/primary_brand</color>
    <color name="deep_indigo">#1A0844</color>
    <color name="indigo_mid">@color/primary_brand</color>
    <color name="neon_cyan">@color/accent_cyan</color>
    <color name="purple_accent">@color/primary_brand_light</color>
    <color name="chip_bg">#1A7C3AFF</color>

    <!-- Light-mode surface/text overrides (used when night mode is OFF) -->
    <color name="surface_card">#FFFFFF</color>
    <color name="icon_tint">#1A1A2E</color>
    <color name="divider_color">#22000000</color>
    <color name="theme_toggle_bg">#E8E8F0</color>

    <!-- Android Material names -->
    <color name="colorPrimary">@color/primary_brand</color>
    <color name="colorPrimaryVariant">@color/primary_brand_dark</color>
    <color name="colorOnPrimary">@color/text_primary</color>
    <color name="colorSecondary">@color/accent_cyan</color>
    <color name="colorSurface">@color/bg_surface</color>
    <color name="colorBackground">@color/bg_main</color>
    <color name="background_card">@color/bg_surface</color>
    <color name="primary_sky_blue">@color/primary_brand</color>
    <color name="primary_soft_blue">@color/primary_brand</color>
    <color name="secondary_mint_green">@color/status_success</color>
    <color name="secondary_lavender">@color/primary_brand_light</color>
    <color name="ai_neon_blue">@color/primary_brand</color>
    <color name="ai_glass_surface">@color/bg_surface</color>
    <color name="pink_touch">@color/accent_pink</color>
    <color name="pink_700">@color/accent_pink</color>
    <color name="md_theme_light_onBackground">@color/text_primary</color>
    <color name="ai_deep_black">@color/bg_main</color>
    <color name="ai_text_primary">@color/text_primary</color>
    <color name="ai_text_secondary">@color/text_secondary</color>
    <color name="ai_surface">@color/bg_surface</color>
    <color name="ai_error_red">@color/status_error</color>
    <color name="ai_neon_purple">@color/primary_brand</color>
    <color name="md_theme_dark_inverseOnSurface">@color/text_primary</color>
    <color name="md_theme_dark_errorContainer">@color/status_error</color>
    <color name="md_theme_dark_onPrimaryContainer">@color/primary_brand</color>
    <color name="md_theme_dark_surface">@color/bg_surface</color>
    <color name="md_theme_dark_scrim">@color/black</color>
    <color name="md_theme_dark_onTertiary">@color/text_primary</color>
    <color name="md_theme_dark_onSurface">@color/text_primary</color>
</resources>
