<resources>
    <style name="Theme.FaceAttribute" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary_brand</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorPrimaryContainer">@color/bg_surface</item>
        <item name="colorOnPrimaryContainer">@color/primary_brand</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/primary_brand_dark</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSecondaryContainer">@color/border_color</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        
        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Typography Defaults -->
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <!-- Typography Styles -->
    <style name="Typography">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Typography.H1">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Typography.H2">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Typography.H3">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Typography.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Typography.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Typography.Micro">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Custom Button Style (Gradient) -->
    <style name="ButtonStyle" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_gradient_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Glassmorphism Card Style -->
    <style name="CardStyle">
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="roundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
