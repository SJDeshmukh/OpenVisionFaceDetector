<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vision_navy_900"
    tools:context=".OwnerActivity">

    <include
        android:id="@+id/owner_header"
        layout="@layout/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/owner_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/owner_bottom_navigation"
        app:layout_constraintTop_toBottomOf="@+id/owner_header" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/owner_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vision_navy_800"
        app:itemIconTint="@color/vision_blue"
        app:itemTextColor="@color/vision_text_secondary"
        app:itemRippleColor="@color/vision_cyan"
        app:itemActiveIndicatorStyle="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/owner_bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        android:elevation="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
