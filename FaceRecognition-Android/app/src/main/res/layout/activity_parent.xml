<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vision_navy_900">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <EditText
            android:id="@+id/et_student_number"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Enter Student Number"
            android:background="@drawable/bg_input_field"
            android:inputType="text"
            android:singleLine="true"
            android:padding="12dp"
            android:textColor="@color/vision_text_primary"
            android:textColorHint="@color/vision_text_tertiary"/>
        <Button
            android:id="@+id/btn_save_student"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save"
            style="@style/ButtonStyle"
            android:layout_marginTop="8dp"/>
        <EditText
            android:id="@+id/et_date"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="YYYY-MM-DD (optional)"
            android:background="@drawable/bg_input_field"
            android:inputType="text"
            android:singleLine="true"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/vision_text_primary"
            android:textColorHint="@color/vision_text_tertiary"/>
        <Button
            android:id="@+id/btn_filter_date"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Filter"
            style="@style/ButtonStyle"
            android:layout_marginTop="8dp"/>
        <LinearLayout
            android:id="@+id/parent_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"/>
        <ImageView
            android:id="@+id/ivParentStatus"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:alpha="0"
            android:visibility="gone"
            android:layout_marginTop="12dp"/>
        <TextView
            android:id="@+id/tvParentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👋"
            android:textSize="56sp"
            android:textColor="@android:color/holo_blue_light"
            android:alpha="0"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</ScrollView>
