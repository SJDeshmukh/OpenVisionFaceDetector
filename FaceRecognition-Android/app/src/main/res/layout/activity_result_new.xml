<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_deep_black"
    tools:context=".ResultActivity">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Analysis Report"
        android:textColor="@color/ai_neon_blue"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent">
    </TextView>

    <LinearLayout
        android:id="@+id/lytImagesTop"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:background="@drawable/glass_panel"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageIdentified"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/ic_faceplugin"
            app:shapeAppearanceOverlay="@style/roundedImageView" />

        <TextView
            android:text="Identified Subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ai_text_secondary"
            android:padding="8dp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lytImagesBottom"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:background="@drawable/glass_panel"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/lytImagesTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageEnrolled"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/ic_faceplugin"
            app:shapeAppearanceOverlay="@style/roundedImageView" />

        <TextView
            android:text="Database Match"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ai_text_secondary"
            android:paddingTop="8dp"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/textPerson"
            android:text="Id: Person18119"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ai_neon_purple"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_details"
        android:layout_width="180dp"
        android:layout_height="52dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/glass_panel"
        android:foreground="@drawable/ripple"
        android:clickable="true"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIEW METRICS"
            android:textColor="@color/ai_neon_blue"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
