<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/bg_history_item"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="6dp">

    <!-- Face thumbnail -->
    <androidx.cardview.widget.CardView
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#1A1A2E">
        <ImageView
            android:id="@+id/iv_face_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/openvision_logo"/>
    </androidx.cardview.widget.CardView>

    <!-- Name + confidence -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">
        <TextView
            android:id="@+id/tv_person_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unknown"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:singleLine="true"/>
        <TextView
            android:id="@+id/tv_confidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0% match"
            android:textSize="11sp"
            android:textColor="#99FFFFFF"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Status toggle and actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">
        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Present"
            android:textSize="11sp"
            android:textColor="@color/present_green"
            android:background="@drawable/bg_checkin_card"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"/>
            
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            
            <TextView
                android:id="@+id/tv_relabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏ Relabel"
                android:textSize="10sp"
                android:textColor="#80D8FF"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>
                
            <TextView
                android:id="@+id/tv_save_face"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💾 Save"
                android:textSize="10sp"
                android:textColor="#B388FF"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
