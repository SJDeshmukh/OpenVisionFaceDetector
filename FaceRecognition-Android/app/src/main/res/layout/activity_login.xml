<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:animateLayoutChanges="true">

    <!-- Status Badge (Traffic Light) -->
    <LinearLayout
        android:id="@+id/status_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/indicator_dot"
            android:backgroundTint="@color/status_success" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="System Online"
            style="@style/Typography.Micro"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <ImageView
                android:id="@+id/logo_login"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/openvision_logo"
                app:layout_constraintBottom_toTopOf="@+id/login_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <!-- Shine overlay for reflective animation -->
            <View
                android:id="@+id/logo_shine"
                android:layout_width="60dp"
                android:layout_height="120dp"
                android:rotation="25"
                android:visibility="gone"
                android:background="@drawable/shine_gradient"
                app:layout_constraintTop_toTopOf="@+id/logo_login"
                app:layout_constraintBottom_toBottomOf="@+id/logo_login"
                app:layout_constraintStart_toStartOf="@+id/logo_login"
                app:layout_constraintEnd_toEndOf="@+id/logo_login" />

            <!-- Login Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/login_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:padding="24dp"
                android:background="@drawable/bg_glass_card"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/logo_login">

                <TextView
                    android:id="@+id/title_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back"
                    style="@style/Typography.H2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_business_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Business: -"
                    style="@style/Typography.Caption"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title_login" />

                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Username"
                    android:inputType="text"
                    android:singleLine="true"
                    android:padding="16dp"
                    style="@style/Typography.Body"
                    android:textColorHint="@color/text_tertiary"
                    app:layout_constraintTop_toBottomOf="@+id/tv_business_name" />

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:padding="16dp"
                    style="@style/Typography.Body"
                    android:textColorHint="@color/text_tertiary"
                    app:layout_constraintTop_toBottomOf="@+id/et_username" />
                
                <EditText
                    android:id="@+id/et_student_id"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Student ID"
                    android:inputType="text"
                    android:singleLine="true"
                    android:padding="16dp"
                    android:visibility="gone"
                    style="@style/Typography.Body"
                    android:textColorHint="@color/text_tertiary"
                    app:layout_constraintTop_toBottomOf="@+id/tv_business_name" />

                <EditText
                    android:id="@+id/et_mobile_number"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Registered Mobile"
                    android:inputType="phone"
                    android:singleLine="true"
                    android:padding="16dp"
                    android:visibility="gone"
                    style="@style/Typography.Body"
                    android:textColorHint="@color/text_tertiary"
                    app:layout_constraintTop_toBottomOf="@+id/et_student_id" />

                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/barrier_inputs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="et_password,et_mobile_number" />

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:text="SIGN IN"
                    style="@style/ButtonStyle"
                    app:layout_constraintTop_toBottomOf="@+id/barrier_inputs" />

                <TextView
                    android:id="@+id/btn_register"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="New User? Register Here"
                    style="@style/Typography.Caption"
                    android:textColor="@color/primary_brand"
                    android:padding="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btn_login" />

                <TextView
                    android:id="@+id/btn_parent_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Parent Portal Login"
                    style="@style/Typography.Caption"
                    android:textColor="@color/primary_brand"
                    android:padding="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btn_register" />

                <TextView
                    android:id="@+id/btn_faculty_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Faculty Login"
                    style="@style/Typography.Caption"
                    android:textColor="@color/primary_brand"
                    android:padding="8dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btn_parent_login" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_server_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Server: ..."
                style="@style/Typography.Micro"
                android:textColor="@color/text_tertiary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/login_card" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
