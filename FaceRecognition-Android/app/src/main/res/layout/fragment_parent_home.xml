<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="16dp">

        <!-- Header: greeting + student name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_home_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning"
                    android:textSize="14sp"
                    android:textColor="#99FFFFFF"/>
                <TextView
                    android:id="@+id/tv_home_student_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Avatar with gradient ring -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">
                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/bg_avatar_ring"
                    android:scaleType="fitXY"/>
                <androidx.cardview.widget.CardView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_surface">
                    <ImageView
                        android:id="@+id/iv_home_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/openvision_logo"/>
                </androidx.cardview.widget.CardView>
            </FrameLayout>
        </LinearLayout>

        <!-- Live Status Card (glassmorphism) -->
        <LinearLayout
            android:id="@+id/card_live_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_status_glass_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Today's Status"
                    android:textSize="13sp"
                    android:textColor="#99FFFFFF"/>
                <!-- Pulse dot -->
                <View
                    android:id="@+id/view_pulse_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/indicator_dot"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/tv_live_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:textSize="11sp"
                    android:textColor="@color/present_green"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Check-In + Check-Out side by side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Check In -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_checkin_card"
                    android:padding="14dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check In"
                        android:textSize="11sp"
                        android:textColor="@color/present_green"/>
                    <TextView
                        android:id="@+id/tv_home_checkin_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_marginTop="4dp"/>
                    <TextView
                        android:id="@+id/tv_home_checkin_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not yet"
                        android:textSize="11sp"
                        android:textColor="#66FFFFFF"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Check Out -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_checkout_card"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check Out"
                        android:textSize="11sp"
                        android:textColor="@color/electric_blue"/>
                    <TextView
                        android:id="@+id/tv_home_checkout_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_marginTop="4dp"/>
                    <TextView
                        android:id="@+id/tv_home_checkout_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not yet"
                        android:textSize="11sp"
                        android:textColor="#66FFFFFF"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Today Summary Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_chip"
                android:padding="12dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/tv_stat_present"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/present_green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Present"
                    android:textSize="11sp"
                    android:textColor="#66FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_chip"
                android:padding="12dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/tv_stat_absent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/absent_red"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Absent"
                    android:textSize="11sp"
                    android:textColor="#66FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_chip"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tv_stat_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/neon_cyan"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rate"
                    android:textSize="11sp"
                    android:textColor="#66FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- AI Insight Card -->
        <LinearLayout
            android:id="@+id/card_ai_insight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_insight_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">
            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="✦"
                android:textSize="18sp"
                android:gravity="center"
                android:textColor="@color/neon_cyan"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:id="@+id/tv_ai_insight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Loading insights..."
                android:textSize="13sp"
                android:textColor="#CCFFFFFF"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

        <!-- Recent Activity (TapInX only) -->
        <TextView
            android:id="@+id/tv_home_recent_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recent Activity"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:id="@+id/home_history_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <!-- Date picker row (TapInX only) -->
        <LinearLayout
            android:id="@+id/row_date_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">
            <EditText
                android:id="@+id/et_home_date"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Select date"
                android:background="@drawable/bg_history_item"
                android:inputType="none"
                android:focusable="false"
                android:singleLine="true"
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textColorHint="#66FFFFFF"
                android:textSize="14sp"/>
            <Button
                android:id="@+id/btn_home_apply_date"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Load"
                android:backgroundTint="@color/indigo_mid"
                android:textColor="@android:color/white"
                android:layout_marginStart="10dp"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>

        <!-- Lecture attendance section (shown for bulk-attendance vendors) -->
        <LinearLayout
            android:id="@+id/layout_lectures_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp">
                <EditText
                    android:id="@+id/et_lec_start"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="From"
                    android:background="@drawable/bg_history_item"
                    android:inputType="none"
                    android:focusable="false"
                    android:singleLine="true"
                    android:padding="10dp"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:textColorHint="#66FFFFFF"/>
                <EditText
                    android:id="@+id/et_lec_end"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="To"
                    android:background="@drawable/bg_history_item"
                    android:inputType="none"
                    android:focusable="false"
                    android:singleLine="true"
                    android:padding="10dp"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:textColorHint="#66FFFFFF"
                    android:layout_marginStart="8dp"/>
                <Button
                    android:id="@+id/btn_load_lectures_home"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Load"
                    android:backgroundTint="@color/indigo_mid"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="8dp"
                    style="?android:attr/borderlessButtonStyle"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_lec_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#99FFFFFF"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/lecture_list_container_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
