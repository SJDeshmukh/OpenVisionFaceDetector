<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12121E">

    <!-- ── Camera section (top 60%) ───────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="60">

        <!-- Camera preview fills the section -->
        <androidx.camera.view.PreviewView
            android:id="@+id/faculty_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Top bar: session label + End Session -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingTop="48dp"
            android:paddingBottom="10dp"
            android:background="#AA000000">

            <TextView
                android:id="@+id/tv_scan_session"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No session"
                android:textSize="13sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"/>

            <Button
                android:id="@+id/btn_end_session"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="End Session"
                android:textSize="11sp"
                android:textColor="#FFFFFFFF"
                android:backgroundTint="#CCF44336"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"/>
        </LinearLayout>

        <!-- Capture ring animation (expands + fades on capture) -->
        <View
            android:id="@+id/view_capture_ring"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="64dp"
            android:background="@drawable/bg_capture_ring"
            android:visibility="invisible"/>

        <!-- Bottom controls: zoom bar + flip FAB + capture FAB -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp"
            android:background="#99000000">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="−"
                android:textColor="#CCFFFFFF"
                android:textSize="20sp"
                android:paddingEnd="4dp"/>

            <SeekBar
                android:id="@+id/seekbar_zoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#CCFFFFFF"
                android:textSize="20sp"
                android:paddingStart="4dp"
                android:paddingEnd="16dp"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_flip_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_flip_camera"
                android:backgroundTint="@color/bg_surface"
                app:fabSize="mini"
                app:elevation="6dp"
                android:contentDescription="Flip camera"
                android:layout_marginEnd="16dp"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_capture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_camera"
                android:backgroundTint="@color/present_green"
                app:fabSize="normal"
                app:rippleColor="@color/neon_cyan"
                app:elevation="8dp"
                android:contentDescription="Capture"/>
        </LinearLayout>
    </FrameLayout>

    <!-- ── Photo grid section (bottom 40%) ────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="40"
        android:orientation="vertical"
        android:background="@drawable/bg_card_dark">

        <TextView
            android:id="@+id/tv_photos_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No photos yet — tap the camera to capture"
            android:textSize="12sp"
            android:textColor="#66FFFFFF"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_photo_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="6dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"/>

    </LinearLayout>

</LinearLayout>
