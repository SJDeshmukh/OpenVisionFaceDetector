<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@color/vision_navy_900">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dynamic scan grid overlay -->
    <View
        android:id="@+id/scanGridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:background="@drawable/bg_bw_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Overlay Gradient to integrate camera into UI -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_gradient_overlay_top"
        app:layout_constraintTop_toTopOf="parent" />

    <com.faceplugin.facerecognition.FaceView
        android:id="@+id/faceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivStatusOverlay"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:visibility="gone"
        android:alpha="0"
        android:src="@drawable/ic_check_in_success"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStatusOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="96sp"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top HUD: status text and similarity bar -->
    <LinearLayout
        android:id="@+id/topHud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/manualActionModeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_attendance_mode_idle"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <View
                android:id="@+id/manualActionModeDot"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:background="@drawable/bg_attendance_mode_dot_idle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="CURRENT ATTENDANCE ACTION"
                    android:textColor="#AFC4C4E0"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/manualActionModeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="SELECT CHECK IN OR CHECK OUT"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/manualActionModeSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Choose an action below before scanning"
                    android:textColor="#C8FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:elevation="8dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="Scanning for registered faces..."
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:id="@+id/similarityBarContainer"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:background="#33000000"
            android:gravity="center_vertical">

            <View
                android:id="@+id/similarityBarFill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_bw_gradient" />
        </LinearLayout>

        <TextView
            android:id="@+id/similarityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Match: 0%"
            android:textColor="#DDFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Online/Offline pill and sync orb -->
    <LinearLayout
        android:id="@+id/networkHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/syncOrb"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_bw_gradient" />

        <TextView
            android:id="@+id/networkStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_network_status_online"
            android:text="ONLINE"
            android:textColor="@android:color/black"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Center AI attendance card -->
    <LinearLayout
        android:id="@+id/attendanceCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:padding="16dp"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/attendanceIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_check_in_success" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/attendanceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checked in"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/attendanceSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Identity confirmed – attendance logged"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/manualAttendancePanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="18dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Attendance action"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAP TO SWITCH"
                android:textColor="#AFC4C4E0"
                android:textSize="9sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkInActionButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:contentDescription="Select check in attendance action"
                android:fontFamily="sans-serif-medium"
                android:text="CHECK IN"
                android:textColor="@color/selector_attendance_action_text"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/selector_attendance_action_background"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_attendance_check_in"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/selector_attendance_action_text"
                app:rippleColor="#3300E87A"
                app:strokeColor="@color/selector_attendance_action_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkOutActionButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:contentDescription="Select check out attendance action"
                android:fontFamily="sans-serif-medium"
                android:text="CHECK OUT"
                android:textColor="@color/selector_attendance_action_text"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/selector_attendance_action_background"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_attendance_check_out"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/selector_attendance_action_text"
                app:rippleColor="#3300E87A"
                app:strokeColor="@color/selector_attendance_action_stroke"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Timeline hint chip -->
    <TextView
        android:id="@+id/timelineChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_glass_card"
        android:text="Last: --"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        android:alpha="0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Power Saving Overlay -->
    <FrameLayout
        android:id="@+id/screenSaverView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivPowerSaveLogo"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/openvision_logo"
                android:alpha="0.9"
                android:layout_marginBottom="24dp"
                android:contentDescription="OpenVision Logo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Power Saving Mode"
                android:textColor="#AAAAAA"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera Active"
                android:textColor="#444444"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
