<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good day,"
                    android:textSize="13sp"
                    android:textColor="#99FFFFFF"/>
                <TextView
                    android:id="@+id/tv_faculty_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Faculty"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="2dp"/>
                <TextView
                    android:id="@+id/tv_faculty_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance Portal"
                    android:textSize="12sp"
                    android:textColor="#66FFFFFF"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/indigo_mid">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✦"
                    android:textSize="22sp"
                    android:textColor="@color/neon_cyan"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Active Session Card -->
        <LinearLayout
            android:id="@+id/card_active_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_status_glass_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Active Session"
                    android:textSize="13sp"
                    android:textColor="#99FFFFFF"/>
                <View
                    android:id="@+id/view_session_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/indicator_dot"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_session_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No session selected"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_session_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap 'New Session' to begin"
                android:textSize="12sp"
                android:textColor="#66FFFFFF"/>

            <!-- Unsynced badge -->
            <LinearLayout
                android:id="@+id/row_unsynced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tv_unsynced_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 records pending sync"
                    android:textSize="12sp"
                    android:textColor="@color/absent_red"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <Button
                    android:id="@+id/btn_sync_now"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Sync Now"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/indigo_mid"
                    style="?android:attr/borderlessButtonStyle"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Actions Grid -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actions"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp"/>

        <!-- Row 1: Scan + Upload -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/btn_scan"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_fab_gradient"
                android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📸" android:textSize="28sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Scan" android:textSize="13sp"
                    android:textColor="@android:color/white" android:layout_marginTop="4dp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_upload"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_checkout_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🖼" android:textSize="28sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Upload Photo" android:textSize="13sp"
                    android:textColor="@android:color/white" android:layout_marginTop="4dp"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Load Students -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/btn_load_students"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_chip">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="👥" android:textSize="28sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Load Students" android:textSize="13sp"
                    android:textColor="@android:color/white" android:layout_marginTop="4dp"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Student count banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_insight_card"
            android:padding="14dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/tv_student_count"
                android:text="Students loaded: 0"
                android:textSize="13sp"
                android:textColor="#CCFFFFFF"/>
            <TextView
                android:id="@+id/tv_model_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Model: Ready"
                android:textSize="11sp"
                android:textColor="@color/present_green"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
