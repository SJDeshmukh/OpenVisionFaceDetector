<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="24dp"/>

        <!-- Avatar + student info card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_status_glass_card"
            android:padding="24dp"
            android:layout_marginBottom="20dp">

            <!-- Avatar with gradient ring -->
            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="14dp">
                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/bg_avatar_ring"
                    android:scaleType="fitXY"/>
                <androidx.cardview.widget.CardView
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="41dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_surface">
                    <ImageView
                        android:id="@+id/iv_profile_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/openvision_logo"/>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/tv_profile_student_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: —"
                android:textSize="13sp"
                android:textColor="#99FFFFFF"
                android:layout_marginBottom="2dp"/>
            <TextView
                android:id="@+id/tv_profile_mobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile: —"
                android:textSize="13sp"
                android:textColor="#99FFFFFF"/>
        </LinearLayout>

        <!-- Actions -->
        <Button
            android:id="@+id/btn_profile_change_face"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Change Registered Face"
            android:backgroundTint="@color/indigo_mid"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btn_profile_logout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Logout"
            android:backgroundTint="@color/absent_red"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            style="?android:attr/borderlessButtonStyle"/>

    </LinearLayout>
</ScrollView>
