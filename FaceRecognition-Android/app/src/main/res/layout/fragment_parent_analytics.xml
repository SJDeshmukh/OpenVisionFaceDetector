<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analytics"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attendance insights &amp; trends"
            android:textSize="13sp"
            android:textColor="#66FFFFFF"
            android:layout_marginBottom="20dp"/>

        <!-- Filter Chips: Week / Month / Year -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <TextView
                android:id="@+id/chip_week"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Week"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_filter_chip"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/chip_month"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Month"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_filter_chip"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/chip_year"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Year"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_filter_chip"/>
        </LinearLayout>

        <!-- Summary numbers row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_chip"
                android:padding="14dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/tv_analytics_present"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/present_green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Present"
                    android:textSize="11sp"
                    android:textColor="#66FFFFFF"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_chip"
                android:padding="14dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/tv_analytics_absent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/absent_red"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Absent"
                    android:textSize="11sp"
                    android:textColor="#66FFFFFF"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_chip"
                android:padding="14dp">
                <TextView
                    android:id="@+id/tv_analytics_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/neon_cyan"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rate"
                    android:textSize="11sp"
                    android:textColor="#66FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Pie Chart Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_status_glass_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attendance Distribution"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="12dp"/>
            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pie_chart"
                android:layout_width="match_parent"
                android:layout_height="200dp"/>
        </LinearLayout>

        <!-- Bar Chart Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_status_glass_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/tv_bar_chart_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weekly Trend"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="12dp"/>
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/bar_chart"
                android:layout_width="match_parent"
                android:layout_height="220dp"/>
        </LinearLayout>

        <!-- AI Insight -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_insight_card"
            android:padding="16dp">
            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="✦"
                android:textSize="18sp"
                android:gravity="center"
                android:textColor="@color/neon_cyan"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:id="@+id/tv_analytics_insight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Analyzing your patterns..."
                android:textSize="13sp"
                android:textColor="#CCFFFFFF"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
