<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ai_deep_black"
    android:paddingBottom="24dp"
    tools:context=".IdentifyDetailsActivity">

    <TextView
        android:id="@+id/title_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Identification Details"
        android:textColor="@color/ai_neon_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/details_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        android:background="@drawable/glass_panel"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/title_details"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textPerson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Identified: Person1"
            android:textColor="@color/ai_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/textSimilarity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Similarity: 0.83"
            android:textColor="@color/ai_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/textLiveness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Liveness score: 0.83"
            android:textColor="@color/ai_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/textYaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yaw: 0.83"
            android:textColor="@color/ai_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/textRoll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Roll: 0.83"
            android:textColor="@color/ai_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/textPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pitch: 0.83"
            android:textColor="@color/ai_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quality: 0.83"
            android:textColor="@color/ai_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtLuminance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Luminance: 0.83"
            android:textColor="@color/ai_text_primary"
            android:textSize="16sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>