<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ParentFaceRegistrationActivity">

    <ImageView
        android:id="@+id/ivRegistrationIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/openvision_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvCameraTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvCameraTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parent Face Registration"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivRegistrationIcon"
        app:layout_constraintBottom_toTopOf="@id/tvCameraSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCameraSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="To approve your child's leaves, we need to securely register your face. Your face data stays on the device and is only used to verify your identity locally."
        android:textColor="#555555"
        android:textSize="16sp"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/tvCameraTitle"
        app:layout_constraintBottom_toTopOf="@id/btnCaptureFace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btnCaptureFace"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Start Face Capture"
        android:backgroundTint="@color/primary_brand"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvCameraSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
