<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow shadow layer -->
    <item>
        <shape>
            <gradient
                android:startColor="#4D7C3AFF"
                android:endColor="#1A06D6FF"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Main gradient button -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="2dp">
        <shape>
            <gradient
                android:startColor="#7C3AFF"
                android:centerColor="#6025E8"
                android:endColor="#5B1EE8"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
