{
  "expo": {
    "name": "Face Capture",
    "slug": "face-capture-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture faces for recognition."
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "package": "com.facecapture.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-camera"]
  }
}
