SECRET_KEY=change_me_in_prod
BACKEND_URL=http://127.0.0.1:5001
FRONTEND_URL=http://localhost:5173
# Database Configuration
# Primary Database (PostgreSQL)
DATABASE_URL=
# Fallback Database (SQLite) - Used only if PostgreSQL is down
DB_PATH=face_db.sqlite
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Gmail SMTP for automated vendor reports. Use a Google App Password, never the account password.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=openvisionx@gmail.com
MAIL_SMTP_APP_PASSWORD=
MAIL_FROM_ADDRESS=openvisionx@gmail.com
MAIL_FROM_NAME=OpenVisionX Reports

# Read-only XChat. The AWS installer asks for Gemini, Mistral, Groq, or disabled.
XCHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=30
MISTRAL_MAX_RETRIES=2
XCHAT_HISTORY_DAYS=30
XCHAT_MAX_MESSAGES=200

# Local XChat voice input. The model is loaded during backend startup only when enabled.
STT_ENABLED=false
STT_MODEL=base
STT_CPU_THREADS=1
STT_MAX_AUDIO_SECONDS=20
STT_MAX_AUDIO_BYTES=2500000
STT_VAD_MIN_SILENCE_MS=500
# Optional fixed language such as en or hi. Leave empty for automatic detection.
STT_LANGUAGE=
