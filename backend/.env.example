# Face Detection Backend Configuration
# Copy this file to .env and adjust values for your environment

# Server Settings
DOMAIN_NAME=openvisionx.in
PORT=5001
PROTOCOL=https

# Secret Key (Change this for production!)
SECRET_KEY=super_secret_key_change_this_in_prod

# Production URLs
# Setup for same-domain hosting (e.g. Nginx Proxy)
# Frontend: https://openvisionx.in
# Backend:  https://openvisionx.in/api (if proxied) or https://api.openvisionx.in
BACKEND_URL=https://openvisionx.in/api
FRONTEND_URL=https://openvisionx.in

# Database
DB_NAME=faces.db
