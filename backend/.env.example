SECRET_KEY=change_me_in_prod
BACKEND_URL=http://127.0.0.1:5001
FRONTEND_URL=http://localhost:5173
# Database Configuration
# Primary Database (PostgreSQL)
DATABASE_URL=
# Fallback Database (SQLite) - Used only if PostgreSQL is down
DB_PATH=face_db.sqlite
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Gmail SMTP for automated vendor reports. Use a Google App Password, never the account password.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=openvisionx@gmail.com
MAIL_SMTP_APP_PASSWORD=
MAIL_FROM_ADDRESS=openvisionx@gmail.com
MAIL_FROM_NAME=OpenVisionX Reports

# Mistral-backed, read-only XChat. Store only in the protected deployment environment.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=30
XCHAT_HISTORY_DAYS=30
XCHAT_MAX_MESSAGES=200
