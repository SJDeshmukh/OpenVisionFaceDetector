SECRET_KEY=change_me_in_prod
BACKEND_URL=http://127.0.0.1:5001
FRONTEND_URL=http://localhost:5173
# Database Configuration
# Primary Database (PostgreSQL)
DATABASE_URL=
# Fallback Database (SQLite) - Used only if PostgreSQL is down
DB_PATH=face_db.sqlite
REDIS_URL=
# RabbitMQ example: amqp://openvision_worker:URL_ENCODED_PASSWORD@127.0.0.1:5672/openvision
# Leave empty to keep using REDIS_URL as the broker.
CELERY_BROKER_URL=
# Keep Celery results in Redis even when RabbitMQ is the broker.
CELERY_RESULT_BACKEND=
CELERY_RESULT_EXPIRES=86400
CELERY_BROKER_HEARTBEAT=30
CELERY_BROKER_POOL_LIMIT=10
# Offload large face images so they are not transported inside AMQP messages.
TASK_PAYLOAD_OFFLOAD=false
TASK_PAYLOAD_DIR=/var/lib/openvision/task-payloads
TASK_PAYLOAD_TTL_SECONDS=3600
TASK_EVENT_VALUE_MAX=2048
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Gmail SMTP for automated vendor reports. Use a Google App Password, never the account password.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=openvisionx@gmail.com
MAIL_SMTP_APP_PASSWORD=
MAIL_FROM_ADDRESS=openvisionx@gmail.com
MAIL_FROM_NAME=OpenVisionX Reports

# Report migration switch. Keep celery until the Lambda pipeline passes staging.
# Set the queue URL from `terraform output database_jobs_queue_url` only at cutover.
REPORT_TASK_BACKEND=celery
REPORT_DATABASE_QUEUE_URL=
REPORT_DLQ_URL=
# Comma-separated vendor IDs. Empty means no vendor can use Lambda; * means full rollout.
REPORT_LAMBDA_VENDOR_IDS=

# Read-only XChat using NVIDIA Nemotron Nano 3 30B on Amazon Bedrock.
XCHAT_PROVIDER=bedrock
AWS_BEDROCK_REGION=ap-south-1
AWS_BEDROCK_RUNTIME_BASE_URL=https://bedrock-runtime.ap-south-1.amazonaws.com
AWS_BEDROCK_MODEL=nvidia.nemotron-nano-3-30b
AWS_BEARER_TOKEN_BEDROCK=
AWS_BEDROCK_TIMEOUT_SECONDS=60
AWS_BEDROCK_MAX_RETRIES=2
AWS_BEDROCK_MAX_OUTPUT_TOKENS=700
SPREADSHEET_LLM_MAPPING_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_REASONING_EFFORT=low
GROQ_MAX_OUTPUT_TOKENS=450
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_API_URL=https://api.cerebras.ai/v1/chat/completions
CEREBRAS_TIMEOUT_SECONDS=30
CEREBRAS_MAX_RETRIES=2
CEREBRAS_MAX_OUTPUT_TOKENS=700
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
OMNIROUTE_API_URL=http://127.0.0.1:20128/v1/chat/completions
OMNIROUTE_TIMEOUT_SECONDS=60
OMNIROUTE_MAX_RETRIES=0
OMNIROUTE_MAX_OUTPUT_TOKENS=700
XCHAT_FALLBACK_PROVIDERS=groq,gemini,cerebras
XCHAT_ORCHESTRATION_PROVIDER_RETRIES=0
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=30
MISTRAL_MAX_RETRIES=2
XCHAT_HISTORY_DAYS=30
XCHAT_MAX_MESSAGES=200

# Local XChat voice input. The model is loaded during backend startup only when enabled.
STT_ENABLED=false
STT_MODEL=base
STT_CPU_THREADS=1
STT_MAX_AUDIO_SECONDS=20
STT_MAX_AUDIO_BYTES=2500000
STT_VAD_MIN_SILENCE_MS=500
# Optional fixed language such as en or hi. Leave empty for automatic detection.
STT_LANGUAGE=
# Persistent directory for Super Admin OTA APK releases.
# Bare-metal AWS setup defaults this to /var/lib/openvision/apks on the EC2 EBS volume.
APK_STORAGE_DIR=/var/lib/openvision/apks
