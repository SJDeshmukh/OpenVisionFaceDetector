# Face Detection Backend Configuration
# Generated for local dev / example usage

# Server Settings
DOMAIN_NAME=openvisionx.in
PORT=5001
PROTOCOL=https

# Secret Key
SECRET_KEY=73f7c1c56c856f2c015fdc59917c92835a790659134facb139784e6198c1ba50

# Production URLs (Targeting openvisionx.in)
BACKEND_URL=https://openvisionx.in/api
FRONTEND_URL=https://openvisionx.in

# Database
# Use postgresql://user:pass@host:port/dbname for primary
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/face_db
# Use sqlite path for fallback
DB_PATH=faces.db
DB_NAME=faces.db

# AI Mode Toggle
# Set USE_LOCAL_AI=True to download and run models locally (High RAM)
# Set USE_LOCAL_AI=False to use remote Northflake API (Low RAM)
USE_LOCAL_AI=True
# Set LOW_RAM_MODE=0 to enable 3D landmarks, GFPGAN, and full-resolution detection
LOW_RAM_MODE=0
NORTHFLAKE_URL=https://tapinx--openvisionfacedetector--g4rz8tx5rcc5.code.run/api/detect

# Celery / Redis (for background image processing)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0